{
  "name": "@fynd-design-engineering/fynd-one-ds",
  "version": "0.10.2",
  "description": "Fynd One Design System — React + TypeScript component library",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fynd-Design-Engineering/fynd-one-ds.git",
    "directory": "workspaces/fynd-one-ds/lahore"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "fynd",
    "design-system",
    "react",
    "components",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/reset.css": "./src/styles/reset.css",
    "./styles/fonts/*": "./dist/fonts/*",
    "./assets/brand-icons/*": "./src/assets/brand-icons/*",
    "./assets/brand-logos/*": "./src/assets/brand-logos/*",
    "./assets/icons/*": "./src/assets/icons/*",
    "./icons/*": {
      "types": "./dist/assets/icons/*/index.d.ts",
      "import": "./dist/assets/icons/*/index.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CLAUDE.md",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:copy-fonts",
    "build:copy-fonts": "mkdir -p dist/fonts && cp src/assets/fonts/* dist/fonts/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^10.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "libphonenumber-js": "^1.12.42",
    "lottie-react": "^2.4.1",
    "motion": "^12.38.0"
  }
}
